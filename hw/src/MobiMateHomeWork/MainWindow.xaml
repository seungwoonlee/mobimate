<Window x:Class="MobiMateHomeWork.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MobiMateHomeWork.ViewModels"
        xmlns:svc="clr-namespace:MobiMateHomeWork.Services"
        Title="숙제" Width="960" Height="520" MinWidth="760" MinHeight="380"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="Manual"
        Background="{DynamicResource Brush.Bg}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Text}" FontSize="{DynamicResource Font.Base}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        Topmost="{Binding AlwaysOnTop}">

    <!-- 직접 그린 제목줄(WindowChrome): 크기 조절 테두리를 살려 Win+화살표·끌어 붙이기(Snap)가 그대로 동작한다. 캡션 영역 32. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Frame" Background="{DynamicResource Brush.Bg}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
        <Grid x:Name="Root">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="28" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 제목줄 32 -->
            <Grid Grid.Row="0" Background="{DynamicResource Brush.Surface}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE73A;" FontFamily="{StaticResource Font.Icon}" FontSize="14" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                    <TextBlock Text="숙제" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Border WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent" Margin="12,0,0,0" Padding="4" VerticalAlignment="Center"
                            ToolTip="{Binding ConnectionTooltip}" AutomationProperties.Name="{Binding ConnectionLabel}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnDot" Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.ConnUnknown}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Connection}" Value="Connected"><Setter Property="Fill" Value="{DynamicResource Brush.ConnConnected}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Connection}" Value="Disconnected"><Setter Property="Fill" Value="{DynamicResource Brush.ConnDisconnected}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Connection}" Value="CliMissing"><Setter Property="Fill" Value="{DynamicResource Brush.ConnCliMissing}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionLabel}" Style="{StaticResource Text.Small}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 리셋 카운트다운 (값은 H4가 더 다듬는다. 지금은 KST 06:00 기준 실제 값) -->
                <TextBlock Grid.Column="2" Text="{Binding Countdown}" Style="{StaticResource Text.Muted}" Margin="0,0,12,0" VerticalAlignment="Center"
                           ToolTip="일일 리셋(매일 06:00)과 주간 리셋(월요일 06:00)까지 남은 시간" />
                <Button Grid.Column="3" x:Name="SettingsButton" Style="{StaticResource Button.Icon}" Content="&#xE713;" Click="OnSettings" Margin="0,0,4,0"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="설정" AutomationProperties.Name="설정" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Button.Caption}" Content="&#xE921;" Click="OnMinimize" ToolTip="최소화" AutomationProperties.Name="최소화" />
                    <Button x:Name="MaxButton" Style="{StaticResource Button.Caption}" Content="&#xE922;" Click="OnMaximize" ToolTip="최대화" AutomationProperties.Name="최대화" />
                    <Button Style="{StaticResource Button.CaptionClose}" Content="&#xE8BB;" Click="OnClose" ToolTip="닫기" AutomationProperties.Name="닫기" />
                </StackPanel>
            </Grid>

            <!-- 경고 띠 (옛 웹앱·CLI 없음 같은 AppEvents 경고). 닫으면 사라지고, 경고가 해소되면 저절로 사라진다. -->
            <Border Grid.Row="1" Background="{DynamicResource Brush.WarnSoft}" BorderBrush="{DynamicResource Brush.Warn}" BorderThickness="0,0,0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BannerVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid MinHeight="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding BannerText}" Foreground="{DynamicResource Brush.Warn}" TextWrapping="Wrap" Margin="12,4,8,4" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource Button.Icon}" Content="&#xE711;" FontSize="10" Width="28" Height="24" Margin="0,0,4,0"
                            Command="{Binding DismissBannerCommand}" ToolTip="닫기" AutomationProperties.Name="경고 닫기" />
                </Grid>
            </Border>

            <!-- 계정 탭 줄 28 -->
            <Grid Grid.Row="2" Margin="12,0,12,0">
                <ListBox Style="{StaticResource PillTabs}" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" VerticalAlignment="Center"
                         AutomationProperties.Name="계정">
                    <ListBox.Visibility>
                        <Binding Path="IsFirstReadPending" Converter="{StaticResource InvertBoolToVisibility}" />
                    </ListBox.Visibility>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AccountTab}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Done}" Margin="0,0,6,0" VerticalAlignment="Center"
                                         Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" ToolTip="접속 중인 계정" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="8" MinWidth="16" Height="16" Margin="6,0,0,0" Padding="5,0">
                                    <TextBlock Text="{Binding Badge}" Style="{StaticResource Text.Small}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- 본문: 왼쪽 숙제 표 영역(H4) + 오른쪽 캐릭터 카드 영역(폭은 배치 단계가 정한다) -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{DynamicResource Metrics.CardWidth}" />
                </Grid.ColumnDefinitions>

                <!-- 숙제 표 자리 (임시: 선택 계정의 캐릭터 이름 목록) -->
                <Grid Grid.Column="0" Margin="12,8,0,8" Visibility="{Binding IsFirstReadPending, Converter={StaticResource InvertBoolToVisibility}}">
                    <ListBox x:Name="CharacterList" Style="{StaticResource List}" ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}"
                             Padding="0,0,10,0" AutomationProperties.Name="캐릭터">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CharacterRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource Brush.DoneFill}" CornerRadius="8" Height="18" Padding="8,0" VerticalAlignment="Center"
                                            Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="접속 중" Style="{StaticResource Text.Small}" Foreground="{DynamicResource Brush.Done}" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- 캐릭터 카드 자리 (임시: 선택 캐릭터 이름) -->
                <Border Grid.Column="1" Margin="12,8,12,8" Visibility="{Binding IsFirstReadPending, Converter={StaticResource InvertBoolToVisibility}}" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedCharacter.Name, FallbackValue=선택한 캐릭터가 없습니다}" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SelectedCharacter.Detail}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- 첫 읽기 전 자리 표시 / 기록이 하나도 없을 때 안내 -->
                <TextBlock Grid.ColumnSpan="2" Text="{Binding PendingText}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsFirstReadPending, Converter={StaticResource BoolToVisibility}}" Padding="16,8" />
                <TextBlock Grid.ColumnSpan="2" Text="{Binding EmptyText}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="24,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasAccounts}" Value="False" />
                                        <Condition Binding="{Binding IsFirstReadPending}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
    </Border>
</Window>
