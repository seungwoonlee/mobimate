<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- 배치 단계 "Narrow": 창 폭이 바뀌어 단계가 달라지면 앱이 이 파일을 통째로 바꿔 끼운다(Viewbox 확대·축소는 쓰지 않는다).
         세 단계 파일의 키는 같아야 한다(LayoutTierResourceTests). 표 쪽 값(줄 높이·칸 크기 등)은 H4가 쓴다. -->
    <sys:Double x:Key="Font.Base">12</sys:Double>
    <sys:Double x:Key="Font.Small">11</sys:Double>
    <GridLength x:Key="Metrics.CardWidth">232</GridLength>
    <sys:Double x:Key="Metrics.RowHeight">44</sys:Double>
    <sys:Double x:Key="Metrics.GroupHeaderHeight">34</sys:Double>
    <sys:Double x:Key="Metrics.CharInfoWidth">146</sys:Double>
    <sys:Double x:Key="Metrics.CellWidth">32</sys:Double>
    <sys:Double x:Key="Metrics.CellHeight">32</sys:Double>
</ResourceDictionary>
