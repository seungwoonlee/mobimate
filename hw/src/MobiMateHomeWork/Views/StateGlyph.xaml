<UserControl x:Class="MobiMateHomeWork.Views.StateGlyph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" Focusable="False">
    <!-- 칸 상태 기호. DataContext = 칸 화면 모델(CellViewModel), 크기 = FontSize. 완료 ✓(초록) / 미완료 ○ / 미확인 · -->
    <Grid>
        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Font.Icon}" Foreground="{DynamicResource Brush.Done}" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextOptions.TextFormattingMode="Ideal"
                   Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}" />
        <TextBlock Text="&#x25CB;" Foreground="{DynamicResource Brush.TextMuted}" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsTodo, Converter={StaticResource BoolToVis}}" />
        <TextBlock Text="&#x00B7;" Foreground="{DynamicResource Brush.TextFaint}" FontWeight="Bold" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsUnknown, Converter={StaticResource BoolToVis}}" />
    </Grid>
</UserControl>
