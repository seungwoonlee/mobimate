<Window x:Class="MobiMateHomeWork.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정 · MobiMate Homework" Icon="/app.ico" Width="460" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Bg}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Text}" FontSize="{DynamicResource Font.Base}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        Topmost="{Binding AlwaysOnTop}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
        <StackPanel>
            <!-- 제목줄 -->
            <Grid Height="32" Background="{DynamicResource Brush.Surface}">
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource Font.Icon}" FontSize="14" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                    <TextBlock Text="설정" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource Button.CaptionClose}" Content="&#xE8BB;" HorizontalAlignment="Right" Click="OnCloseClick"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="닫기" AutomationProperties.Name="닫기" />
            </Grid>

            <StackPanel Margin="16,16,16,16">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE756;" FontFamily="{StaticResource Font.Icon}" FontSize="14" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="게임 CLI 경로" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                <TextBlock Text="비워 두면 웹앱 설정 → 기본 경로 순으로 찾습니다." Style="{StaticResource Text.Small}" Margin="0,2,0,8" TextWrapping="Wrap" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CliBox" AutomationProperties.Name="게임 CLI 경로" KeyDown="OnCliKeyDown" LostFocus="OnCliLostFocus" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Click="OnBrowse"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="찾아보기" /></StackPanel></Button>
                </Grid>
                <TextBlock x:Name="CliState" Style="{StaticResource Text.Small}" Margin="0,6,0,0" TextWrapping="Wrap" />

                <Rectangle Height="1" Fill="{DynamicResource Brush.Line}" Margin="0,16,0,16" />

                <CheckBox x:Name="TopBox" Style="{StaticResource CheckBox.Toggle}" Content="항상 위 (게임 옆에 띄워 두기)" Click="OnTopClick" AutomationProperties.Name="항상 위" />
                <CheckBox x:Name="TrayBox" Style="{StaticResource CheckBox.Toggle}" Content="닫으면 트레이로 (끄면 닫을 때 종료)" Margin="0,12,0,0" Click="OnTrayClick" AutomationProperties.Name="닫으면 트레이로" />

                <Rectangle Height="1" Fill="{DynamicResource Brush.Line}" Margin="0,16,0,16" />

                <!-- 배경 그림: 공식 일러스트 6개(처음 한 번 이 PC에만 내려받는다) / 내 그림 / 끄기 + 투명도 -->
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE91B;" FontFamily="{StaticResource Font.Icon}" FontSize="14" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="배경 그림" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                <TextBlock Text="마비노기 모바일 공식 일러스트를 처음 한 번 이 PC에만 내려받아 씁니다." Style="{StaticResource Text.Small}" Margin="0,2,0,8" TextWrapping="Wrap" />
                <WrapPanel x:Name="BgThumbs" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="BgCustomButton" Click="OnPickBackground" AutomationProperties.Name="내 그림 고르기"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B9;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="내 그림 고르기…" /></StackPanel></Button>
                    <Button x:Name="BgOffButton" Margin="8,0,0,0" Click="OnBackgroundOff" AutomationProperties.Name="배경 그림 끄기"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="끄기" /></StackPanel></Button>
                </StackPanel>
                <TextBlock x:Name="BgState" Style="{StaticResource Text.Small}" Margin="0,6,0,0" TextWrapping="Wrap" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"><TextBlock Text="&#xE706;" FontFamily="{StaticResource Font.Icon}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="투명도" /></StackPanel>
                    <Slider x:Name="BgOpacity" Grid.Column="1" Minimum="5" Maximum="40" SmallChange="1" LargeChange="5" TickFrequency="5" IsMoveToPointEnabled="True"
                            VerticalAlignment="Center" ValueChanged="OnOpacityChanged" PreviewMouseLeftButtonUp="OnOpacityCommit" KeyUp="OnOpacityCommit" AutomationProperties.Name="배경 투명도" />
                    <TextBlock x:Name="BgOpacityText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,20,0,0">
                    <TextBlock x:Name="VersionText" Style="{StaticResource Text.Small}" VerticalAlignment="Center" AutomationProperties.Name="버전" />
                    <Button Style="{StaticResource Button.Accent}" HorizontalAlignment="Right" MinWidth="72" IsDefault="True" IsCancel="True" Click="OnCloseClick"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="닫기" /></StackPanel></Button>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
