<Window x:Class="MobiMateHomeWork.MergeCharacterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="캐릭터 합치기 · MobiMate Homework" Icon="/app.ico" Width="420" SizeToContent="Height" MaxHeight="560" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Bg}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Text}" FontSize="{DynamicResource Font.Base}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
        <StackPanel>
            <Grid Height="32" Background="{DynamicResource Brush.Surface}">
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8F4;" FontFamily="{StaticResource Font.Icon}" FontSize="14" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                    <TextBlock Text="캐릭터 합치기" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource Button.CaptionClose}" Content="&#xE8BB;" HorizontalAlignment="Right" Click="OnCancel"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="닫기" AutomationProperties.Name="닫기" />
            </Grid>

            <StackPanel Margin="16">
                <TextBlock x:Name="Intro" TextWrapping="Wrap" />
                <TextBlock Text="같은 캐릭터가 둘로 나뉘어 기록됐을 때(예: 아이라_전사 / 아이라_전사#2) 하나로 모읍니다." Style="{StaticResource Text.Small}" Margin="0,4,0,10" TextWrapping="Wrap" />
                <ListBox x:Name="List" MaxHeight="260" DisplayMemberPath="Label" AutomationProperties.Name="합칠 대상 캐릭터" MouseDoubleClick="OnDoubleClick" />
                <CheckBox x:Name="AllJobs" Style="{StaticResource CheckBox.Toggle}" Content="같은 서버의 모든 직업 보기" Margin="0,10,0,0" Click="OnFilterChanged" AutomationProperties.Name="모든 직업 보기" />
                <Grid Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button MinWidth="72" IsCancel="True" Click="OnCancel"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="취소" /></StackPanel></Button>
                        <Button x:Name="Next" Style="{StaticResource Button.Accent}" MinWidth="72" Margin="8,0,0,0" IsDefault="True" Click="OnNext" IsEnabled="False"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE76C;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="다음…" /></StackPanel></Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
