<UserControl x:Class="MobiMateHomeWork.Views.CharacterCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MobiMateHomeWork.ViewModels">
    <!-- 선택한 캐릭터 카드(정보 12항목). DataContext = HomeworkBoardViewModel. 값은 Board.Card가 갖는다.
         캐릭명(닉네임) · 클래스·레벨 · 칭호 · 현재 맵 · 전투력/마도 저항/생활력/매력(2×2) · 은동전 · 마족 공물 · 가방 무게 · 마지막 접속 -->
    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,10,10,8" Focusable="False"
                          Visibility="{Binding HasCard, Converter={StaticResource BoolToVis}}">
                <StackPanel DataContext="{Binding Card}">
                    <!-- 머리: 뱃지 · 이름(눌러서 바꾸기) · 클래스 레벨 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="100" Background="{Binding JobColor}" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="{Binding JobLetter}" Foreground="{DynamicResource Brush.OnAccent}" FontWeight="Bold" FontSize="{DynamicResource Font.Title}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <!-- 이름: 눌러서(또는 연필 단추로) 그 자리에서 바꾸기 (Enter 저장 · Esc 취소 · 20자) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="NameText" Text="{Binding Name}" FontWeight="SemiBold" FontSize="{DynamicResource Font.Title}" TextTrimming="CharacterEllipsis"
                                           Cursor="IBeam" MouseLeftButtonUp="OnNameClicked" ToolTip="눌러서 이름 바꾸기" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRenaming}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="NameBox" Grid.ColumnSpan="2" Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" MinHeight="26" Padding="6,2"
                                         KeyDown="OnNameKeyDown" LostKeyboardFocus="OnNameLostFocus" IsVisibleChanged="OnNameBoxVisibleChanged"
                                         AutomationProperties.Name="새 이름 (Enter 저장, Esc 취소)">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRenaming}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <Button Grid.Column="1" Content="&#xE70F;" FontSize="11" Width="22" Height="22" Margin="2,0,0,0" Click="OnRenameButton"
                                        ToolTip="이름 바꾸기" AutomationProperties.Name="이름 바꾸기">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRenaming}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                <TextBlock Text="{Binding ClassLevel}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource Brush.DoneFill}" CornerRadius="8" Height="16" Padding="7,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="접속 중" Style="{StaticResource Text.Small}" Foreground="{DynamicResource Brush.Done}" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding RenameError}" Foreground="{DynamicResource Brush.Danger}" Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding HasRenameError, Converter={StaticResource BoolToVis}}" />

                    <!-- 칭호 · 현재 맵 -->
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Small}" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" ToolTip="{Binding Title}" />
                    <Grid Margin="0,3,0,0" ToolTip="{Binding MapText}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE707;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Grid.Column="1" Text="{Binding MapText}" FontSize="{DynamicResource Font.Small}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>

                    <!-- 전투력·마도 저항·생활력·매력 (2×2) -->
                    <ItemsControl ItemsSource="{Binding Tiles}" Margin="0,8,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StatTile}">
                                <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="6" Padding="8,4" Margin="0,0,4,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Small}" />
                                        <TextBlock Text="{Binding Value}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 은동전 · 마족 공물 · 가방 무게 -->
                    <ContentControl Content="{Binding Silver}" Margin="0,6,0,0" Focusable="False" />
                    <ContentControl Content="{Binding Tribute}" Margin="0,7,0,0" Focusable="False" />
                    <ContentControl Content="{Binding Weight}" Margin="0,7,0,0" Focusable="False" />

                    <TextBlock Text="{Binding LastSeenText}" Style="{StaticResource Text.Small}" Margin="0,8,0,0" ToolTip="{Binding LastSeenTooltip}" />
                </StackPanel>
            </ScrollViewer>
            <TextBlock Text="캐릭터를 고르면 여기에 자세한 정보가 보입니다." Style="{StaticResource Text.Muted}" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                       Visibility="{Binding HasCard, Converter={StaticResource InvertBoolToVisibility}}" />
        </Grid>
    </Border>
</UserControl>
