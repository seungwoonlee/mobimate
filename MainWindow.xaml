<Window x:Class="MobiMate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MobiMate"
        mc:Ignorable="d"
        Title="모비노기 AI도우미 (MobiMate)" 
        Height="960" Width="1300" MinHeight="520" MinWidth="600"
        Background="#141518" WindowStartupLocation="CenterScreen"
        FontFamily="Malgun Gothic, Segoe UI" FontSize="16">

    <!-- ESC 키 누르면 즉시 긴급 정지 실행 -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding EmergencyStopCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- 모던 다크 & 고대비 일러스트 색상 팔레트 -->
        <SolidColorBrush x:Key="BgPrimary" Color="#141518"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#1E2024"/>
        <SolidColorBrush x:Key="BgCard" Color="#282B30"/>
        <SolidColorBrush x:Key="BgCardSub" Color="#202226"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#5865F2"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#23A55A"/>
        <SolidColorBrush x:Key="AccentRed" Color="#ED4245"/>
        <SolidColorBrush x:Key="AccentYellow" Color="#FEE75C"/>
        <SolidColorBrush x:Key="AccentGold" Color="#FFA000"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#A855F7"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#00BCD4"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A3A6AA"/>
        <SolidColorBrush x:Key="BorderColor" Color="#383A40"/>

        <!-- 퀵 질문 칩 버튼 스타일 -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Background" Value="#2B3245"/>
            <Setter Property="Foreground" Value="#79B8FF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#384260"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#384260"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 큰 비주얼 카드 스타일 -->
        <Style x:Key="VisualCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- 대형 프로그레스바 스타일 -->
        <Style x:Key="BigProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="#1C1D21"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="Root">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10"/>
                            <Border x:Name="PART_Track" CornerRadius="10"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="10"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 탭 버튼 스타일 (대형 글자) -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Background="{TemplateBinding Background}" CornerRadius="8,8,0,0" Margin="0,0,4,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource BgSecondary}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#25272C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 다크 테마 ComboBoxItem 스타일 (호버/선택 완벽한 가독성 확보) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#25272C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#384260"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBlue}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 다크 테마 ComboBox 스타일 (드롭다운 팝업 포함) -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Border x:Name="Border" Background="#25272C" BorderBrush="#383A40" BorderThickness="1" CornerRadius="6"/>
                <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Fill="#A3A6AA" Data="M 0 0 L 4 4 L 8 0 Z"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#2B2D31"/>
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#25272C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#383A40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Template="{StaticResource DarkComboBoxToggleButton}"
                                          Focusable="false" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,6,30,6"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="300">
                                    <Border x:Name="DropDownBorder" Background="#202226" BorderThickness="1" BorderBrush="#383A40" CornerRadius="6" Margin="0,4,0,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="4" Opacity="0.6"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="60"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 1. 상단 글로벌 헤더 -->
            <RowDefinition Height="Auto"/> <!-- 2. 인앱 토스트 알림바 -->
            <RowDefinition Height="*"/>    <!-- 3. 상단 6대 정보 탭 -->
            <RowDefinition Height="5"/>    <!-- 4. 상하 분할 스플리터 -->
            <RowDefinition Height="330" MinHeight="180"/> <!-- 5. 하단 상시 고정 2분할 채팅창 -->
        </Grid.RowDefinitions>

        <!-- ================= 1. 상단 글로벌 헤더 ================= -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondary}" Padding="20,12" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 좌측: 캐릭터 정보 & 세션 변화량 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatusIcon" Text="🟢" FontSize="28" Margin="0,0,14,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtCharTitle" Text="[아이라] 격투가 Lv.100" FontWeight="Bold" FontSize="22" Foreground="{StaticResource TextPrimary}"/>
                            
                            <!-- 전투력 및 변화량 뱃지 -->
                            <Border Background="#35373C" CornerRadius="6" Padding="10,3" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtCombatScore" Text="⚔️ 전투력 88,737" FontSize="15" Foreground="{StaticResource AccentYellow}" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtCombatDelta" Text=" (+150 ▲)" FontSize="14" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <!-- 활동 상태 램프 -->
                            <Border x:Name="BadgeActivity" Background="#1C3829" CornerRadius="6" Padding="8,3" Margin="8,0,0,0">
                                <TextBlock x:Name="TxtActivity" Text="대기 중 (Idle)" FontSize="14" Foreground="{StaticResource AccentGreen}" FontWeight="Bold"/>
                            </Border>

                            <!-- 게임 데이터 수집 출처 표기 배지 -->
                            <Border Background="#1C2E46" CornerRadius="6" Padding="8,3" Margin="8,0,0,0">
                                <TextBlock Text="📡 게임 연동: 넥슨 MM AI CLI" FontSize="13" Foreground="#58A6FF" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtLocation" Text="📍 페카 고분 심층 2층 3구역 (맑음 ☀️)  |  에린 시간 2959-4-23" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 우측: 제어 버튼들 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🛑 긴급 정지 (ESC)" Click="BtnEmergencyStop_Click" Background="{StaticResource AccentRed}" Foreground="White" FontWeight="Bold" FontSize="14" Padding="16,8" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <ToggleButton x:Name="BtnTopmost" Content="📌 항상 위" Click="BtnTopmost_Click"
                                  Background="#35373C" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="14"
                                  Padding="14,8" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBlue}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <Button x:Name="BtnRefreshCurrentTab" Content="🔄 탭 새로고침" Click="BtnRefreshCurrentTab_Click"
                            Background="{StaticResource AccentBlue}" Foreground="White" FontWeight="Bold" FontSize="14"
                            Padding="16,8" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 2. 인앱 비동기 토스트 알림바 ================= -->
        <Border Grid.Row="1" x:Name="ToastBar" Background="#1C3829" Padding="16,10" Visibility="Collapsed">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ToastIcon" Text="✓" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" FontSize="16" Margin="0,0,10,0"/>
                    <TextBlock x:Name="ToastText" Text="알림 메시지" FontWeight="SemiBold" Foreground="White" FontSize="15"/>
                </StackPanel>
                <Button Content="✕" Click="BtnCloseToast_Click" HorizontalAlignment="Right" Background="Transparent" Foreground="{StaticResource TextSecondary}" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="16"/>
            </Grid>
        </Border>

        <!-- ================= 3. 상단 6대 정보 탭 (1줄 고정 스크롤 래퍼) ================= -->
        <Grid Grid.Row="2" Margin="12,10,12,6">
            <TabControl x:Name="MainTabControl" SelectionChanged="MainTabControl_SelectionChanged" Background="{StaticResource BgSecondary}" BorderThickness="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- 탭 1줄 고정 수평 스크롤 래퍼 (절대 2줄 래핑 방지) -->
                            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <TabPanel IsItemsHost="True"/>
                            </ScrollViewer>
                            <Border Grid.Row="1" Background="{TemplateBinding Background}" CornerRadius="0,0,8,8">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>

                <!-- [1] 📊 캐릭터 & 스탯 탭 -->
                <TabItem Header="  📊 캐릭터 &amp; 스탯  ">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <TextBlock Text="🏆 캐릭터 종합 4대 점수" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="18" Margin="0,0,0,10"/>
                            <UniformGrid Columns="4" Margin="0,0,0,18">
                                <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="16,12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="⚔️ 전투력" FontSize="14" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock x:Name="TxtScoreCombat" Text="88,737" FontWeight="Bold" FontSize="26" Foreground="{StaticResource AccentYellow}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="16,12" Margin="4,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="🌿 생활력" FontSize="14" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock x:Name="TxtScoreLiving" Text="23,011" FontWeight="Bold" FontSize="26" Foreground="{StaticResource AccentGreen}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="16,12" Margin="4,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="✨ 매력" FontSize="14" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock x:Name="TxtScoreAttract" Text="19,745" FontWeight="Bold" FontSize="26" Foreground="{StaticResource AccentPurple}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="16,12" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="🎨 데코 점수" FontSize="14" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock x:Name="TxtScoreDecor" Text="5,445" FontWeight="Bold" FontSize="26" Foreground="{StaticResource AccentCyan}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <TextBlock Text="🛡️ 전투 기본 능력치" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="18" Margin="0,0,0,10"/>
                            <Border Style="{StaticResource VisualCard}">
                                <UniformGrid Columns="3" Rows="3">
                                    <TextBlock x:Name="TxtStatHp" Text="❤️ 최대 체력: 72,614" Foreground="{StaticResource TextPrimary}" FontSize="16" Margin="10,10"/>
                                    <TextBlock x:Name="TxtStatAtk" Text="⚔️ 공격력: 33,338" Foreground="{StaticResource TextPrimary}" FontSize="16" Margin="10,10"/>
                                    <TextBlock x:Name="TxtStatDef" Text="🛡️ 방어력: 19,178" Foreground="{StaticResource TextPrimary}" FontSize="16" Margin="10,10"/>
                                    <TextBlock x:Name="TxtStatMdef" Text="🔮 마도 저항: 4,316" Foreground="{StaticResource TextPrimary}" FontSize="16" Margin="10,10"/>
                                    <TextBlock x:Name="TxtStatStr" Text="💪 힘 (STR): 4,996" Foreground="{StaticResource TextPrimary}" FontSize="16" Margin="10,10"/>
                                    <TextBlock x:Name="TxtStatDex" Text="🎯 솜씨 (DEX): 6,019" Foreground="{StaticResource TextPrimary}" FontSize="16" Margin="10,10"/>
                                    <TextBlock x:Name="TxtStatInt" Text="🧠 지력 (INT): 5,116" Foreground="{StaticResource TextPrimary}" FontSize="16" Margin="10,10"/>
                                    <TextBlock x:Name="TxtStatLuck" Text="🍀 행운 (LUCK): 5,402" Foreground="{StaticResource TextPrimary}" FontSize="16" Margin="10,10"/>
                                    <TextBlock x:Name="TxtStatWill" Text="🔥 의지 (WILL): 4,812" Foreground="{StaticResource TextPrimary}" FontSize="16" Margin="10,10"/>
                                </UniformGrid>
                            </Border>

                            <TextBlock Text="👑 성기사 (Paladin) 스탯" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="18" Margin="0,6,0,10"/>
                            <Border Style="{StaticResource VisualCard}">
                                <UniformGrid Columns="3" Rows="2">
                                    <TextBlock x:Name="TxtPalAtk" Text="신성력: 54" Foreground="{StaticResource TextPrimary}" FontSize="16" Margin="10,10"/>
                                    <TextBlock x:Name="TxtPalDef" Text="항마력: 54" Foreground="{StaticResource TextPrimary}" FontSize="16" Margin="10,10"/>
                                    <TextBlock x:Name="TxtPalJustice" Text="정의: 694" Foreground="{StaticResource TextPrimary}" FontSize="16" Margin="10,10"/>
                                    <TextBlock x:Name="TxtPalJudge" Text="심판: 459" Foreground="{StaticResource TextPrimary}" FontSize="16" Margin="10,10"/>
                                    <TextBlock x:Name="TxtPalOrder" Text="질서: 694" Foreground="{StaticResource TextPrimary}" FontSize="16" Margin="10,10"/>
                                    <TextBlock x:Name="TxtPalBless" Text="가호: 459" Foreground="{StaticResource TextPrimary}" FontSize="16" Margin="10,10"/>
                                </UniformGrid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- [2] 🎒 가방 & 아이템 탭 -->
                <TabItem Header="  🎒 가방 &amp; 소지품 (600여종)  ">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource VisualCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎒 인벤토리 소지 무게" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="16"/>
                                        <TextBlock x:Name="TxtWeightDelta" Text=" (-12.5 ▼)" FontSize="15" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" Margin="8,0,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtWeightSummary" HorizontalAlignment="Right" Text="854.6 / 1030.0 (83.0%)" FontWeight="Bold" Foreground="{StaticResource AccentYellow}" FontSize="16"/>
                                </Grid>
                                <ProgressBar x:Name="ProgWeightTab" Style="{StaticResource BigProgress}" Value="83" Foreground="{StaticResource AccentYellow}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtWeightStatus" Text="⚠️ 여유 공간이 얼마 남지 않았습니다." FontSize="14" Foreground="{StaticResource AccentYellow}"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtItemSearch" Grid.Column="0" TextChanged="TxtItemSearch_TextChanged"
                                     Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}" BorderThickness="0"
                                     Padding="12,10" FontSize="15">
                                <TextBox.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                                <Button Content="전체" Click="BtnItemFilter_Click" Tag="All" Background="{StaticResource AccentBlue}" Foreground="White" FontWeight="Bold" Padding="14,8" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand"/>
                                <Button Content="🎒 가방" Click="BtnItemFilter_Click" Tag="Bag" Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" Padding="14,8" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand"/>
                                <Button Content="🏛️ 계정 창고" Click="BtnItemFilter_Click" Tag="AccountStorage" Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" Padding="14,8" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand"/>
                                <Button Content="📦 캐릭터 창고" Click="BtnItemFilter_Click" Tag="CharacterStorage" Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" Padding="14,8" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand"/>
                            </StackPanel>

                            <TextBlock x:Name="TxtItemCountLabel" Grid.Column="2" Text="총 609개 아이템" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" FontSize="14"/>
                        </Grid>

                        <ListView x:Name="ListItemView" Grid.Row="2" Background="{StaticResource BgCard}" BorderThickness="0" Foreground="{StaticResource TextPrimary}" FontSize="15"
                                  VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="보관 위치" Width="140" DisplayMemberBinding="{Binding Location}"/>
                                    <GridViewColumn Header="카테고리" Width="150" DisplayMemberBinding="{Binding CategoryName}"/>
                                    <GridViewColumn Header="아이템 명" Width="380" DisplayMemberBinding="{Binding DisplayName}"/>
                                    <GridViewColumn Header="수량" Width="90" DisplayMemberBinding="{Binding Count}"/>
                                    <GridViewColumn Header="잠금 상태" Width="90" DisplayMemberBinding="{Binding IsLocked}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>

                <!-- [3] 💰 재화 & 화폐 탭 (변화량 표시) -->
                <TabItem Header="  💰 재화 &amp; 화폐 (28종)  ">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <!-- 세션 누적 획득 요약 바 -->
                            <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📈 이번 접속 세션 누적 획득: " FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="16"/>
                                    <TextBlock x:Name="TxtGoldDeltaSummary" Text="골드 +0 G" Foreground="{StaticResource AccentGold}" FontWeight="Bold" FontSize="16" Margin="10,0,15,0"/>
                                    <TextBlock x:Name="TxtWingsDeltaSummary" Text="날개 +0개" Foreground="#4EBAE0" FontWeight="Bold" FontSize="16" Margin="0,0,15,0"/>
                                    <TextBlock x:Name="TxtNyangDeltaSummary" Text="냥토큰 +0개" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="16"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="💎 전체 28종 보유 재화 및 레이드 증표" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="18" Margin="0,0,0,12"/>
                            <ItemsControl x:Name="ListAllCurrencies">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="16,14" Margin="6">
                                            <Grid>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="15" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Amount, StringFormat='{}{0:N0}'}" HorizontalAlignment="Right" Foreground="{StaticResource AccentGold}" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- [4] 📜 미션 & 퀘스트 탭 -->
                <TabItem Header="  📜 미션 &amp; 퀘스트  ">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource VisualCard}" Margin="0,0,8,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📅 오늘의 일일 미션 (11개)" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="17"/>
                                        <TextBlock x:Name="TxtMissionDelta" Text=" (+2 완료 ▲)" FontSize="15" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" Margin="8,0,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Grid>
                                <ProgressBar x:Name="ProgDailyMissions" Grid.Row="1" Style="{StaticResource BigProgress}" Value="100" Foreground="{StaticResource AccentGreen}" Margin="0,0,0,12"/>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ListDailyMissionsFull">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource BgCardSub}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                                    <Grid>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="✅ " Foreground="{StaticResource AccentGreen}" FontSize="15"/>
                                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="15"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="22,4,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource AccentYellow}" FontWeight="Bold" FontSize="14">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0} / {1}">
                                                                    <Binding Path="CurrentCount"/>
                                                                    <Binding Path="GoalCount"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource VisualCard}" Margin="8,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="📆 이번 주 주간 미션 (15개)" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="17" Margin="0,0,0,8"/>
                                <ProgressBar x:Name="ProgWeeklyMissions" Grid.Row="1" Style="{StaticResource BigProgress}" Value="70" Foreground="{StaticResource AccentBlue}" Margin="0,0,0,12"/>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ListWeeklyMissionsFull">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource BgCardSub}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                                    <Grid>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="15"/>
                                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" FontSize="14">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0} / {1}">
                                                                    <Binding Path="CurrentCount"/>
                                                                    <Binding Path="GoalCount"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- [5] 🌿 생활 & 생산 탭 -->
                <TabItem Header="  🌿 생활 &amp; 생산 (가공·채집)  ">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource VisualCard}" Margin="0,0,8,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="⚗️ 가공 시설 대기열" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="17"/>
                                    <Button Content="수거하기" Click="BtnCollectWorks_Click" HorizontalAlignment="Right" Background="{StaticResource AccentGreen}" Foreground="White" FontWeight="Bold" FontSize="14" Padding="14,6" BorderThickness="0" Cursor="Hand"/>
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ListAlteringWorks">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource BgCardSub}" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                                                    <Grid>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="16"/>
                                                            <TextBlock Text="{Binding FacilityName, StringFormat='작업 시설: {0}'}" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding RemainingSeconds, StringFormat='남은 시간: {0}초'}" Foreground="{StaticResource AccentYellow}" FontWeight="Bold" FontSize="14"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource VisualCard}" Margin="8,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="🌾 150종 스마트 채집 도우미" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="17" Margin="0,0,0,10"/>

                                <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                                    <Button Content="🍎 사과" Click="ChipGather_Click" Tag="사과" Background="#35373C" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Padding="12,6" Margin="0,0,6,6" Cursor="Hand"/>
                                    <Button Content="🪵 장작" Click="ChipGather_Click" Tag="나무 장작" Background="#35373C" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Padding="12,6" Margin="0,0,6,6" Cursor="Hand"/>
                                    <Button Content="🥚 달걀" Click="ChipGather_Click" Tag="달걀" Background="#35373C" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Padding="12,6" Margin="0,0,6,6" Cursor="Hand"/>
                                    <Button Content="🐑 양털" Click="ChipGather_Click" Tag="양털" Background="#35373C" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Padding="12,6" Margin="0,0,6,6" Cursor="Hand"/>
                                    <Button Content="⛏️ 철광석" Click="ChipGather_Click" Tag="철광석" Background="#35373C" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Padding="12,6" Margin="0,0,6,6" Cursor="Hand"/>
                                </WrapPanel>

                                <TextBox x:Name="TxtGatherSearchFull" Grid.Row="2" TextChanged="TxtGatherSearchFull_TextChanged"
                                         Background="{StaticResource BgCardSub}" Foreground="{StaticResource TextPrimary}" BorderThickness="0"
                                         Padding="12,10" FontSize="14" Margin="0,0,0,10"/>

                                <ListView x:Name="ListGatherablesView" Grid.Row="3" Background="{StaticResource BgCardSub}" BorderThickness="0" Foreground="{StaticResource TextPrimary}"
                                          VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="6,4">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="15" VerticalAlignment="Center"/>
                                                <Button Content="채집 시작" Click="BtnStartGather_Click" Tag="{Binding DisplayName}"
                                                        HorizontalAlignment="Right" Background="{StaticResource AccentGreen}" Foreground="White"
                                                        FontWeight="Bold" FontSize="13" Padding="12,5" BorderThickness="0" Cursor="Hand"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- [6] 👥 주변 레이더 탭 -->
                <TabItem Header="  👥 주변 레이더 (22명)  ">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="📡 내 주변 플레이어 실시간 레이더 (거리순)" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="17" Margin="0,0,0,12"/>
                        <ListView x:Name="ListNearPcsView" Grid.Row="1" Background="{StaticResource BgCard}" BorderThickness="0" Foreground="{StaticResource TextPrimary}" FontSize="15"
                                  VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="거리 (m)" Width="100" DisplayMemberBinding="{Binding Distance, StringFormat='{}{0:F1}m'}"/>
                                    <GridViewColumn Header="길드 소속" Width="130">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding IsSameGuild, StringFormat='길드원: {0}'}" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="직업 및 레벨" Width="200">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Run Text="{Binding JobName}" FontWeight="Bold"/>
                                                    <Run Text=" Lv."/>
                                                    <Run Text="{Binding Level}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="전투력" Width="140" DisplayMemberBinding="{Binding CombatScore, StringFormat='{}{0:N0}'}"/>
                                    <GridViewColumn Header="칭호 / 서버" Width="220">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Title, StringFormat='[{0}]'}" Foreground="{StaticResource TextSecondary}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ================= 4. 상하 크기 조절 스플리터 ================= -->
        <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderColor}" Cursor="SizeNS"/>

        <!-- ================= 5. 하단 상시 고정 2분할 채팅창 ================= -->
        <Grid Grid.Row="4" Background="{StaticResource BgSecondary}" Margin="12,4,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 5-1. 좌측: 🎮 인게임 전체 채팅 (상시 고정) -->
            <Border Grid.Column="0" Background="{StaticResource BgCard}" CornerRadius="8" Padding="14" Margin="0,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 배너 -->
                        <RowDefinition Height="*"/>    <!-- 전송 로그 -->
                        <RowDefinition Height="Auto"/> <!-- 입력부 -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#3A2A1A" CornerRadius="6" Padding="12,6" Margin="0,0,0,8">
                        <TextBlock Text="📢 인게임 전체 채팅 (Enter 즉시 전송, 최대 50자, @@ 불필요)" 
                                   Foreground="#FFA940" FontSize="14" FontWeight="Bold"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" x:Name="ScrollGameChatLog" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                        <ItemsControl x:Name="ListGameChatLogs">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgCardSub}" CornerRadius="6" Padding="12,8" Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Timestamp}" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,12,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="SemiBold"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <TextBlock x:Name="TxtChatEmotePreview" Text="" HorizontalAlignment="Left" Foreground="#E5C07B" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtCharLimit" Text="0 / 50자" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtGameChatInput" Grid.Column="0" KeyDown="TxtGameChatInput_KeyDown" TextChanged="TxtGameChatInput_TextChanged"
                                     MaxLength="50"
                                     Background="{StaticResource BgCardSub}" Foreground="{StaticResource TextPrimary}" BorderThickness="0"
                                     Padding="14,10" FontSize="15">
                                <TextBox.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                            <Button x:Name="BtnSendGameChat" Grid.Column="1" Content="게임 전송 ↵" Click="BtnSendGameChat_Click"
                                    Background="{StaticResource AccentBlue}" Foreground="White" FontWeight="Bold" FontSize="14"
                                    Padding="18,10" BorderThickness="0" Margin="8,0,0,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderColor}" Cursor="SizeWE"/>

            <!-- 5-2. 우측: 🤖 AI 코파일럿 대화 (상시 고정 & 엔진 선택기) -->
            <Border Grid.Column="2" Background="{StaticResource BgCard}" CornerRadius="8" Padding="14" Margin="4,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 엔진 선택 및 배너 헤더 -->
                        <RowDefinition Height="*"/>    <!-- AI 피드 -->
                        <RowDefinition Height="Auto"/> <!-- 입력부 -->
                    </Grid.RowDefinitions>

                    <!-- AI 엔진 선택기 헤더 -->
                    <Border Grid.Row="0" Background="#1C2E46" CornerRadius="6" Padding="12,6" Margin="0,0,0,8">
                        <Grid>
                            <TextBlock Text="🤖 공략 &amp; 대화 AI 엔진" Foreground="#58A6FF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="엔진: " Foreground="{StaticResource TextSecondary}" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="CmbAiEngine" Style="{StaticResource DarkComboBox}" SelectionChanged="CmbAiEngine_SelectionChanged" Width="260" Margin="0,0,4,0">
                                    <ComboBoxItem Content="⏳ AI 엔진 검색 중..." IsSelected="True"/>
                                </ComboBox>
                                <Button x:Name="BtnReloadAiModels" Content="🔄" Click="BtnReloadAiModels_Click" ToolTip="설치된 AI 엔진 새로고침"
                                        Background="#2B2D31" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="14"
                                        Padding="8,4" BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" x:Name="ScrollAiFeed" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                        <ItemsControl x:Name="ListAiMessages">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,8" MaxWidth="550">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource BgCardSub}"/>
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter Property="Background" Value="#384260"/>
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Sender}" FontSize="13" FontWeight="Bold" Margin="0,0,0,4">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" FontSize="15"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- 퀵 공략 칩 바 -->
                            <RowDefinition Height="Auto"/> <!-- 입력부 -->
                        </Grid.RowDefinitions>

                        <!-- 5대 퀵 공략 칩 바 (내장 가이드 모드 시 상시 노출, 가로 스크롤) -->
                        <ScrollViewer Grid.Row="0" x:Name="ScrollQuickChips" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8" Visibility="Visible">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="⚔️ 전투력/룬" Tag="전투력" Click="BtnQuickChip_Click" Style="{StaticResource ChipButton}" Margin="0,0,6,0"/>
                                <Button Content="💰 골드/재화" Tag="골드" Click="BtnQuickChip_Click" Style="{StaticResource ChipButton}" Margin="0,0,6,0"/>
                                <Button Content="🌿 채집/가공" Tag="채집" Click="BtnQuickChip_Click" Style="{StaticResource ChipButton}" Margin="0,0,6,0"/>
                                <Button Content="🛡️ 던전/보스" Tag="던전" Click="BtnQuickChip_Click" Style="{StaticResource ChipButton}" Margin="0,0,6,0"/>
                                <Button Content="📊 캐릭터 진단" Tag="진단" Click="BtnQuickChip_Click" Style="{StaticResource ChipButton}"/>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtAiInput" Grid.Column="0" KeyDown="TxtAiInput_KeyDown"
                                     Background="{StaticResource BgCardSub}" Foreground="{StaticResource TextPrimary}" BorderThickness="0"
                                     Padding="14,10" FontSize="15">
                                <TextBox.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                            <Button x:Name="BtnSendAi" Grid.Column="1" Content="AI 질문 ↵" Click="BtnSendAi_Click"
                                    Background="{StaticResource AccentBlue}" Foreground="White" FontWeight="Bold" FontSize="14"
                                    Padding="18,10" BorderThickness="0" Margin="8,0,0,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
