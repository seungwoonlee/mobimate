<Window x:Class="MobiMate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MobiMate"
        mc:Ignorable="d"
        Title="모비노기 AI도우미 (MobiMate)" 
        Height="960" Width="1300" MinHeight="520" MinWidth="600"
        Background="#0F1012" WindowStartupLocation="CenterScreen"
        FontFamily="Malgun Gothic, Segoe UI" FontSize="16">

    <!-- ESC 키 누르면 즉시 긴급 정지 실행 -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding EmergencyStopCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- 불리언 가시성 컨버터 -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- 프리미엄 게이밍 다크 & 고대비 일러스트 색상 팔레트 -->
        <SolidColorBrush x:Key="BgPrimary" Color="#0F1012"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#181A1E"/>
        <SolidColorBrush x:Key="BgCard" Color="#22252B"/>
        <SolidColorBrush x:Key="BgCardSub" Color="#1A1C22"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#5865F2"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#23A55A"/>
        <SolidColorBrush x:Key="AccentRed" Color="#ED4245"/>
        <SolidColorBrush x:Key="AccentYellow" Color="#FEE75C"/>
        <SolidColorBrush x:Key="AccentGold" Color="#FFA000"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#A855F7"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#00BCD4"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A3A6AA"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2E323B"/>

        <!-- 완성형 문장 가이드 카드 스타일 -->
        <Style x:Key="GuideSentenceCard" TargetType="Button">
            <Setter Property="Background" Value="#1C212D"/>
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2E3A52"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2B3654"/>
                    <Setter Property="BorderBrush" Value="#5865F2"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 퀵 질문 칩 버튼 스타일 (하위 호환) -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Background" Value="#2B3245"/>
            <Setter Property="Foreground" Value="#79B8FF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#384260"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#384260"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 큰 비주얼 카드 스타일 -->
        <Style x:Key="VisualCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- 대형 프로그레스바 스타일 -->
        <Style x:Key="BigProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="#1C1D21"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="Root">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10"/>
                            <Border x:Name="PART_Track" CornerRadius="10"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="10"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 탭 버튼 스타일 (대형 글자) -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Background="{TemplateBinding Background}" CornerRadius="8,8,0,0" Margin="0,0,4,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource BgSecondary}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#25272C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 다크 테마 ComboBoxItem 스타일 (호버/선택 완벽한 가독성 확보) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#25272C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#384260"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBlue}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 다크 테마 ComboBox 스타일 (드롭다운 팝업 포함) -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Border x:Name="Border" Background="#25272C" BorderBrush="#383A40" BorderThickness="1" CornerRadius="6"/>
                <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Fill="#A3A6AA" Data="M 0 0 L 4 4 L 8 0 Z"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#2B2D31"/>
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#25272C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#383A40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Template="{StaticResource DarkComboBoxToggleButton}"
                                          Focusable="false" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,6,30,6"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="300">
                                    <Border x:Name="DropDownBorder" Background="#202226" BorderThickness="1" BorderBrush="#383A40" CornerRadius="6" Margin="0,4,0,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="4" Opacity="0.6"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="60"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 모던 토글 스위치 스타일 (아무말 On/Off) -->
        <Style x:Key="ModernSwitchToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="SwitchTrack" Background="#383A40" CornerRadius="11" BorderThickness="1" BorderBrush="#4E5058"/>
                            <Ellipse x:Name="SwitchThumb" Width="16" Height="16" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#23A55A"/>
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#23A55A"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="SwitchThumb" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. 상단 글로벌 헤더 -->
            <RowDefinition Height="1*"/>   <!-- 1. 상단 6대 정보 탭 (상하 1:1 비율) -->
            <RowDefinition Height="5"/>    <!-- 2. 상하 분할 스플리터 -->
            <RowDefinition Height="1*" MinHeight="320"/> <!-- 3. 하단 상시 고정 2분할 채팅창 (2배 높이 확보) -->
        </Grid.RowDefinitions>

        <!-- ================= 0. Floating Overlay 토스트 알림바 (본문 흔들림 0%) ================= -->
        <Border Grid.Row="0" Grid.RowSpan="4" x:Name="ToastBar" Background="#1C3829" BorderBrush="#2EA043" BorderThickness="1" CornerRadius="8" Padding="18,10" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0" Panel.ZIndex="1000" Visibility="Collapsed" MaxWidth="600">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.6" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ToastIcon" Text="✓" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" FontSize="16" Margin="0,0,10,0"/>
                    <TextBlock x:Name="ToastText" Text="알림 메시지" FontWeight="SemiBold" Foreground="White" FontSize="14"/>
                </StackPanel>
                <Button Content="✕" Click="BtnCloseToast_Click" HorizontalAlignment="Right" Background="Transparent" Foreground="{StaticResource TextSecondary}" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="15" Margin="16,0,0,0"/>
            </Grid>
        </Border>

        <!-- ================= 1. 상단 글로벌 헤더 ================= -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondary}" Padding="16,8" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 좌측: 캐릭터 정보 & 세션 변화량 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatusIcon" Text="🟢" FontSize="28" Margin="0,0,14,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtCharTitle" Text="[아이라] 격투가 Lv.100" FontWeight="Bold" FontSize="22" Foreground="{StaticResource TextPrimary}"
                                       Cursor="Hand" ToolTip="클릭하여 캐릭터 닉네임(별칭)을 설정하거나 변경할 수 있습니다." MouseLeftButtonUp="TxtCharTitle_MouseLeftButtonUp"/>

                            <!-- 닉네임 미등록 온보딩 말풍선 (클릭 시 닉네임 설정 팝업 호출) -->
                            <Border x:Name="BubbleNickGuide" Background="#3B2A14" BorderBrush="#E5A93C" BorderThickness="1" CornerRadius="10" Padding="8,3" Margin="8,0,0,0" Cursor="Hand" MouseLeftButtonUp="TxtCharTitle_MouseLeftButtonUp" Visibility="Collapsed" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="💬 클릭해서 닉네임 등록!" FontSize="12" Foreground="#F5D061" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <!-- 닉네임 설정 인라인 팝업 -->
                            <Popup x:Name="PopupNickName" PlacementTarget="{Binding ElementName=TxtCharTitle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                <Border Background="#202226" BorderBrush="{StaticResource AccentBlue}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.6"/>
                                    </Border.Effect>
                                    <StackPanel Width="220">
                                        <TextBlock Text="🏷️ 캐릭터 별칭(닉네임) 설정" Foreground="White" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                                        <TextBox x:Name="TxtCustomNickInput" Background="#181A1E" Foreground="White" Padding="8,5" FontSize="13" BorderBrush="#383A40" BorderThickness="1" KeyDown="TxtCustomNickInput_KeyDown">
                                            <TextBox.Resources>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                </Style>
                                            </TextBox.Resources>
                                        </TextBox>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                            <Button Content="취소" Click="BtnCancelNick_Click" Background="#35373C" Foreground="White" Padding="8,4" FontSize="12" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"/>
                                            <Button Content="저장" Click="BtnSaveNick_Click" Background="{StaticResource AccentBlue}" Foreground="White" FontWeight="Bold" Padding="10,4" FontSize="12" BorderThickness="0" Cursor="Hand"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Popup>
                            
                            <!-- 전투력 및 변화량 뱃지 -->
                            <Border Background="#35373C" CornerRadius="6" Padding="10,3" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtCombatScore" Text="⚔️ 전투력 88,737" FontSize="15" Foreground="{StaticResource AccentYellow}" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtCombatDelta" Text=" (+150 ▲)" FontSize="14" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <!-- 활동 상태 램프 -->
                            <Border x:Name="BadgeActivity" Background="#1C3829" CornerRadius="6" Padding="8,3" Margin="8,0,0,0">
                                <TextBlock x:Name="TxtActivity" Text="대기 중 (Idle)" FontSize="14" Foreground="{StaticResource AccentGreen}" FontWeight="Bold"/>
                            </Border>

                            <!-- 게임 데이터 수집 출처 표기 배지 -->
                            <Border Background="#1C2E46" CornerRadius="6" Padding="8,3" Margin="8,0,0,0">
                                <TextBlock Text="📡 게임 연동: 넥슨 MM AI CLI" FontSize="13" Foreground="#58A6FF" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtLocation" Text="📍 페카 고분 심층 2층 3구역 (맑음 ☀️)  |  에린 시간 2959-4-23" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 우측: 제어 버튼들 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🛑 긴급 정지 (ESC)" Click="BtnEmergencyStop_Click" Background="{StaticResource AccentRed}" Foreground="White" FontWeight="Bold" FontSize="14" Padding="16,8" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <ToggleButton x:Name="BtnTopmost" Content="📌 항상 위" Click="BtnTopmost_Click"
                                  Background="#35373C" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="14"
                                  Padding="14,8" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBlue}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <Button x:Name="BtnRefreshCurrentTab" Content="🔄 탭 새로고침" Click="BtnRefreshCurrentTab_Click"
                            Background="{StaticResource AccentBlue}" Foreground="White" FontWeight="Bold" FontSize="14"
                            Padding="16,8" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 2. 상단 6대 정보 탭 (1줄 고정 스크롤 래퍼, 상하 1:1 비율) ================= -->
        <Grid Grid.Row="1" Margin="12,4,12,4">
            <TabControl x:Name="MainTabControl" SelectionChanged="MainTabControl_SelectionChanged" Background="{StaticResource BgSecondary}" BorderThickness="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- 탭 1줄 고정 수평 스크롤 래퍼 (절대 2줄 래핑 방지) -->
                            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <TabPanel IsItemsHost="True"/>
                            </ScrollViewer>
                            <Border Grid.Row="1" Background="{TemplateBinding Background}" CornerRadius="0,0,8,8">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>

                <!-- [1] 📊 스탯 탭 -->
                <TabItem x:Name="TabCharStats" Header="  📊 스탯  ">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <TextBlock Text="🏆 캐릭터 종합 4대 점수" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="18" Margin="0,0,0,10"/>
                            <UniformGrid Columns="4" Margin="0,0,0,18">
                                <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="16,12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="⚔️ 전투력" FontSize="14" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock x:Name="TxtScoreCombat" Text="88,737" FontWeight="Bold" FontSize="26" Foreground="{StaticResource AccentYellow}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="16,12" Margin="4,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="🌿 생활력" FontSize="14" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock x:Name="TxtScoreLiving" Text="23,011" FontWeight="Bold" FontSize="26" Foreground="{StaticResource AccentGreen}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="16,12" Margin="4,0,4,0">
                                    <StackPanel>
