                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- [2] 🎒 가방 & 창고 탭 -->
                <TabItem x:Name="TabInventory" Header="  🎒 가방 &amp; 창고  ">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource VisualCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎒 인벤토리 소지 무게" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="16"/>
                                        <TextBlock x:Name="TxtWeightDelta" Text=" (-12.5 ▼)" FontSize="15" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" Margin="8,0,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtWeightSummary" HorizontalAlignment="Right" Text="854.6 / 1030.0 (83.0%)" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" FontSize="16"/>
                                </Grid>
                                <ProgressBar x:Name="ProgWeightTab" Style="{StaticResource BigProgress}" Value="83" Foreground="{StaticResource AccentGreen}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtWeightStatus" Text="✓ 가방 무게 정상 (95% 미만). 활동에 지장이 없습니다." FontSize="14" Foreground="{StaticResource AccentGreen}"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtItemSearch" Grid.Column="0" TextChanged="TxtItemSearch_TextChanged"
                                     Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}" BorderThickness="0"
                                     Padding="12,10" FontSize="15">
                                <TextBox.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                <Button x:Name="BtnFilterAll" Content="전체" Click="BtnItemFilter_Click" Tag="All" Background="{StaticResource AccentBlue}" Foreground="White" FontWeight="Bold" Padding="12,8" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand"/>
                                <Button x:Name="BtnFilterBag" Content="🎒 가방" Click="BtnItemFilter_Click" Tag="Bag" Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" Padding="12,8" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand"/>
                                <Button x:Name="BtnFilterAccount" Content="🏛️ 계정 창고" Click="BtnItemFilter_Click" Tag="AccountStorage" Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" Padding="12,8" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand"/>
                                <Button x:Name="BtnFilterChar" Content="📦 캐릭터 창고" Click="BtnItemFilter_Click" Tag="CharacterStorage" Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" Padding="12,8" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand"/>
                                <Button x:Name="BtnFilterDiet" Content="⚖️ 무게 다이어트" Click="BtnItemFilter_Click" Tag="Diet" Background="#3A2818" Foreground="#F5CBA7" FontWeight="Bold" Padding="12,8" BorderThickness="1" BorderBrush="#5D4020" Margin="6,0,6,0" Cursor="Hand" ToolTip="가방 내 비잠금 무거운 잡템/재료를 수량순으로 우선 정렬합니다."/>
                            </StackPanel>

                            <TextBlock x:Name="TxtItemCountLabel" Grid.Column="2" Text="총 609개 아이템" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" FontSize="14"/>
                        </Grid>

                        <ListView x:Name="ListItemView" Grid.Row="2" Background="{StaticResource BgCard}" BorderThickness="0" Foreground="{StaticResource TextPrimary}" FontSize="15"
                                  VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="보관 위치" Width="130" DisplayMemberBinding="{Binding Location}"/>
                                    <GridViewColumn Header="카테고리" Width="140" DisplayMemberBinding="{Binding CategoryName}"/>
                                    <GridViewColumn Header="아이템 명" Width="360" DisplayMemberBinding="{Binding DisplayName}"/>
                                    <GridViewColumn Header="보유 수량" Width="100" DisplayMemberBinding="{Binding Count}"/>
                                    <GridViewColumn Header="이번 접속 증가량 (다이어트)" Width="190">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DeltaBadge}" Foreground="{StaticResource AccentYellow}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="잠금 상태" Width="90" DisplayMemberBinding="{Binding IsLocked}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>

                <!-- [3] 💰 재화 탭 -->
                <TabItem x:Name="TabCurrency" Header="  💰 재화  ">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <!-- 세션 누적 획득 요약 바 -->
                            <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📈 이번 접속 세션 누적 획득: " FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="16"/>
                                    <TextBlock x:Name="TxtGoldDeltaSummary" Text="골드 +0 G" Foreground="{StaticResource AccentGold}" FontWeight="Bold" FontSize="16" Margin="10,0,15,0"/>
                                    <TextBlock x:Name="TxtWingsDeltaSummary" Text="날개 +0개" Foreground="#4EBAE0" FontWeight="Bold" FontSize="16" Margin="0,0,15,0"/>
                                    <TextBlock x:Name="TxtNyangDeltaSummary" Text="냥토큰 +0개" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="16"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="💎 전체 28종 보유 재화 및 레이드 증표" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="18" Margin="0,0,0,12"/>
                            <ItemsControl x:Name="ListAllCurrencies">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="16,14" Margin="6">
                                            <Grid>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="15" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Amount, StringFormat='{}{0:N0}'}" HorizontalAlignment="Right" Foreground="{StaticResource AccentGold}" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- [4] 📋 미션 탭 -->
                <TabItem x:Name="TabMissions" Header="  📋 미션  ">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource VisualCard}" Margin="0,0,8,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TxtDailyMissionHeader" Text="📅 오늘의 잔여 일일 미션" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="17"/>
                                        <TextBlock x:Name="TxtMissionDelta" Text=" (+2 완료 ▲)" FontSize="15" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" Margin="8,0,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Grid>
                                <ProgressBar x:Name="ProgDailyMissions" Grid.Row="1" Style="{StaticResource BigProgress}" Value="100" Foreground="{StaticResource AccentGreen}" Margin="0,0,0,12"/>
                                <Grid Grid.Row="2">
                                    <TextBlock x:Name="TxtDailyAllDoneBanner" Text="🎉 오늘의 모든 일일 숙제를 완료했습니다!" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    <ScrollViewer x:Name="ScrollDailyMissions" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="ListDailyMissionsFull">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource BgCardSub}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                                        <Grid>
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="📌 " Foreground="{StaticResource AccentYellow}" FontSize="15"/>
                                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="15"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="22,4,0,0"/>
                                                            </StackPanel>
                                                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource AccentYellow}" FontWeight="Bold" FontSize="14">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0} / {1}">
                                                                        <Binding Path="CurrentCount"/>
                                                                        <Binding Path="GoalCount"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource VisualCard}" Margin="8,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="TxtWeeklyMissionHeader" Grid.Row="0" Text="📆 이번 주 잔여 주간 미션" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="17" Margin="0,0,0,8"/>
                                <ProgressBar x:Name="ProgWeeklyMissions" Grid.Row="1" Style="{StaticResource BigProgress}" Value="70" Foreground="{StaticResource AccentBlue}" Margin="0,0,0,12"/>
                                <Grid Grid.Row="2">
                                    <TextBlock x:Name="TxtWeeklyAllDoneBanner" Text="🎉 이번 주의 모든 주간 미션을 완료했습니다!" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    <ScrollViewer x:Name="ScrollWeeklyMissions" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="ListWeeklyMissionsFull">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource BgCardSub}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                                    <Grid>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="15"/>
                                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" FontSize="14">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0} / {1}">
                                                                    <Binding Path="CurrentCount"/>
                                                                    <Binding Path="GoalCount"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- [5] 🌿 생활 탭 -->
                <TabItem x:Name="TabLife" Header="  🌿 생활  ">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource VisualCard}" Margin="0,0,8,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="⚗️ 가공 시설 대기열" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="17"/>
                                    <Button Content="수거하기" Click="BtnCollectWorks_Click" HorizontalAlignment="Right" Background="{StaticResource AccentGreen}" Foreground="White" FontWeight="Bold" FontSize="14" Padding="14,6" BorderThickness="0" Cursor="Hand"/>
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ListAlteringWorks">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource BgCardSub}" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                                                    <Grid>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="16"/>
                                                            <TextBlock Text="{Binding FacilityName, StringFormat='작업 시설: {0}'}" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding RemainingSeconds, StringFormat='남은 시간: {0}초'}" Foreground="{StaticResource AccentYellow}" FontWeight="Bold" FontSize="14"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource VisualCard}" Margin="8,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- 타이틀 -->
                                    <RowDefinition Height="Auto"/> <!-- 카테고리 필터 바 -->
                                    <RowDefinition Height="Auto"/> <!-- 목표 수량 설정 바 (프리셋 + 세밀조절) -->
                                    <RowDefinition Height="Auto"/> <!-- 검색창 -->
                                    <RowDefinition Height="*"/>    <!-- 채집 가능 아이템 목록 -->
                                </Grid.RowDefinitions>

                                <!-- 0. 타이틀 -->
                                <TextBlock Grid.Row="0" Text="🌾 스마트 채집 도우미 (목표 달성형 수집)" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="17" Margin="0,0,0,8"/>

                                <!-- 1. 카테고리 필터 바 -->
                                <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                                    <Button x:Name="BtnGatherCatAll" Content="전체" Click="BtnGatherCategory_Click" Tag="All" Background="{StaticResource AccentBlue}" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Padding="10,5" Margin="0,0,5,5" Cursor="Hand"/>
                                    <Button x:Name="BtnGatherCatLogging" Content="🪵 벌목" Click="BtnGatherCategory_Click" Tag="벌목" Background="#2A2D35" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="13" BorderThickness="0" Padding="10,5" Margin="0,0,5,5" Cursor="Hand"/>
                                    <Button x:Name="BtnGatherCatMining" Content="⛏️ 채광" Click="BtnGatherCategory_Click" Tag="채광" Background="#2A2D35" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="13" BorderThickness="0" Padding="10,5" Margin="0,0,5,5" Cursor="Hand"/>
                                    <Button x:Name="BtnGatherCatFarm" Content="🌾 농축산" Click="BtnGatherCategory_Click" Tag="농축산" Background="#2A2D35" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="13" BorderThickness="0" Padding="10,5" Margin="0,0,5,5" Cursor="Hand"/>
                                    <Button x:Name="BtnGatherCatHerb" Content="🌿 약초" Click="BtnGatherCategory_Click" Tag="약초" Background="#2A2D35" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="13" BorderThickness="0" Padding="10,5" Margin="0,0,5,5" Cursor="Hand"/>
                                    <Button x:Name="BtnGatherCatEtc" Content="📦 기타" Click="BtnGatherCategory_Click" Tag="기타" Background="#2A2D35" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="13" BorderThickness="0" Padding="10,5" Margin="0,0,5,5" Cursor="Hand"/>
                                </WrapPanel>

                                <!-- 2. 목표 수량 설정 바 (프리셋 5, 50, 100, 200, 300 + 세밀조절 -1/+1) -->
                                <Border Grid.Row="2" Background="#181B20" BorderBrush="#2D323E" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 좌측 프리셋 버튼군 -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🎯 목표치:" Foreground="{StaticResource TextSecondary}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Button Content="5개" Click="BtnTargetPreset_Click" Tag="5" Background="#2C303B" Foreground="White" FontSize="12" FontWeight="Bold" Padding="8,4" Margin="0,0,4,0" BorderThickness="0" Cursor="Hand"/>
                                            <Button Content="50개" Click="BtnTargetPreset_Click" Tag="50" Background="#2C303B" Foreground="White" FontSize="12" FontWeight="Bold" Padding="8,4" Margin="0,0,4,0" BorderThickness="0" Cursor="Hand"/>
                                            <Button Content="100개" Click="BtnTargetPreset_Click" Tag="100" Background="{StaticResource AccentBlue}" Foreground="White" FontSize="12" FontWeight="Bold" Padding="8,4" Margin="0,0,4,0" BorderThickness="0" Cursor="Hand"/>
                                            <Button Content="200개" Click="BtnTargetPreset_Click" Tag="200" Background="#2C303B" Foreground="White" FontSize="12" FontWeight="Bold" Padding="8,4" Margin="0,0,4,0" BorderThickness="0" Cursor="Hand"/>
                                            <Button Content="300개" Click="BtnTargetPreset_Click" Tag="300" Background="#2C303B" Foreground="White" FontSize="12" FontWeight="Bold" Padding="8,4" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand"/>
                                        </StackPanel>

                                        <!-- 세밀 조절부 -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="-5" Click="BtnAdjustTarget_Click" Tag="-5" Background="#353945" Foreground="White" FontSize="12" FontWeight="Bold" Padding="6,3" Margin="0,0,3,0" BorderThickness="0" Cursor="Hand"/>
                                            <Button Content="-1" Click="BtnAdjustTarget_Click" Tag="-1" Background="#353945" Foreground="White" FontSize="12" FontWeight="Bold" Padding="6,3" Margin="0,0,4,0" BorderThickness="0" Cursor="Hand"/>
                                            <TextBox x:Name="TxtTargetGatherCount" Text="100" TextChanged="TxtTargetGatherCount_TextChanged"
                                                     Width="54" Height="26" TextAlignment="Center" FontWeight="Bold" FontSize="13"
                                                     Background="#101216" Foreground="{StaticResource AccentYellow}" BorderBrush="#3A4050" BorderThickness="1" VerticalContentAlignment="Center"/>
                                            <Button Content="+1" Click="BtnAdjustTarget_Click" Tag="1" Background="#353945" Foreground="White" FontSize="12" FontWeight="Bold" Padding="6,3" Margin="4,0,3,0" BorderThickness="0" Cursor="Hand"/>
                                            <Button Content="+5" Click="BtnAdjustTarget_Click" Tag="5" Background="#353945" Foreground="White" FontSize="12" FontWeight="Bold" Padding="6,3" Margin="0,0,0,0" BorderThickness="0" Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 3. 검색창 -->
                                <TextBox x:Name="TxtGatherSearchFull" Grid.Row="3" TextChanged="TxtGatherSearchFull_TextChanged"
                                         Background="{StaticResource BgCardSub}" Foreground="{StaticResource TextPrimary}" BorderThickness="0"
                                         Padding="12,8" FontSize="14" Margin="0,0,0,8">
                                    <TextBox.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>

                                <!-- 4. 채집 가능 전체 아이템 목록 -->
                                <ListView x:Name="ListGatherablesView" Grid.Row="4" Background="{StaticResource BgCardSub}" BorderThickness="0" Foreground="{StaticResource TextPrimary}"
                                          VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                                          HorizontalContentAlignment="Stretch">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,6"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">
                                                        <ContentPresenter HorizontalAlignment="Stretch"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#20232A" CornerRadius="6" Padding="14,10" HorizontalAlignment="Stretch">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="15" VerticalAlignment="Center"/>
                                                            <Border Background="#2C3240" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Category}" Foreground="#79B8FF" FontSize="11" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource AccentYellow}" FontSize="13" Margin="0,4,0,0"/>
                                                    </StackPanel>

                                                    <Button Grid.Column="1" Click="BtnStartGatherTarget_Click" Tag="{Binding DisplayName}"
                                                            Background="{StaticResource AccentGreen}" Foreground="White" FontWeight="Bold" FontSize="13" Padding="14,8" MinWidth="104" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Content" Value="수집 시작 ▶"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTargetReached}" Value="True">
                                                                        <Setter Property="Background" Value="#2E3440"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                                        <Setter Property="Content" Value="목표 달성 ✓"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- [6] 👥 레이더 탭 -->
                <TabItem x:Name="TabRadar" Header="  👥 레이더  ">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="📡 내 주변 플레이어 실시간 레이더 (거리순)" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="17" Margin="0,0,0,12"/>
                        <ListView x:Name="ListNearPcsView" Grid.Row="1" Background="{StaticResource BgCard}" BorderThickness="0" Foreground="{StaticResource TextPrimary}" FontSize="15"
                                  VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="거리 (m)" Width="100" DisplayMemberBinding="{Binding Distance, StringFormat='{}{0:F1}m'}"/>
                                    <GridViewColumn Header="길드 소속" Width="130">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding IsSameGuild, StringFormat='길드원: {0}'}" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="직업 및 레벨" Width="200">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Run Text="{Binding JobName}" FontWeight="Bold"/>
                                                    <Run Text=" Lv."/>
                                                    <Run Text="{Binding Level}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="전투력" Width="140" DisplayMemberBinding="{Binding CombatScore, StringFormat='{}{0:N0}'}"/>
                                    <GridViewColumn Header="칭호 / 서버" Width="220">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Title, StringFormat='[{0}]'}" Foreground="{StaticResource TextSecondary}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ================= 3. 상하 크기 조절 스플리터 ================= -->
        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderColor}" Cursor="SizeNS"/>

        <!-- ================= 4. 하단 상시 고정 2분할 채팅창 (상하 1:1 비율) ================= -->
        <Grid Grid.Row="3" Background="{StaticResource BgSecondary}" Margin="12,2,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 5-1. 좌측: 🎮 인게임 전체 채팅 (상시 고정) -->
            <Border Grid.Column="0" Background="{StaticResource BgCard}" CornerRadius="8" Padding="12" Margin="0,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 배너 -->
                        <RowDefinition Height="Auto"/> <!-- 아무말 대잔치 컨트롤 패널 -->
                        <RowDefinition Height="*"/>    <!-- 전송 로그 -->
                        <RowDefinition Height="Auto"/> <!-- 입력부 -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#3A2A1A" CornerRadius="6" Padding="12,6" Margin="0,0,0,6">
                        <TextBlock Text="📢 인게임 전체 채팅 (최대 50자)" 
                                    Foreground="#FFA940" FontSize="14" FontWeight="Bold"/>
                    </Border>

                    <!-- 🗣️ 아무말 대잔치 (페르소나 혼잣말) 컨트롤 패널 -->
                    <Border Grid.Row="1" Background="#211A14" BorderBrush="#42301A" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                        <Grid>
                            <!-- 좌측: 제목 라벨 & 페르소나 선택 -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="🗣️ 아무말 대잔치" FontWeight="Bold" Foreground="#F0B27A" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="페르소나:" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CmbPersona" Style="{StaticResource DarkComboBox}" SelectionChanged="CmbPersona_SelectionChanged" Width="190" FontSize="12">
                                    <ComboBoxItem Content="🌹 악덕영애 스타일" Tag="Villainess" IsSelected="True"/>
                                    <ComboBoxItem Content="💰 구두쇠 영감 스타일" Tag="Scrooge"/>
                                    <ComboBoxItem Content="☀️ 안녕하닝 모닝이야" Tag="MorningSpirit"/>
                                    <ComboBoxItem Content="🌊 갱상도 아재 스타일" Tag="GyeongsangAhjussi"/>
                                    <ComboBoxItem Content="✨ 아이돌 댄서 스타일" Tag="IdolDancer"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- 우측: 한마디 대사 자동 채우기 버튼 -->
                            <Button x:Name="BtnTriggerChatterNow" Content="💬 한마디" Click="BtnTriggerChatterNow_Click" ToolTip="현재 상황에 맞춘 페르소나 대사를 생성하여 아래 입력창에 채워넣습니다."
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="#3A2B18" Foreground="#F5CBA7" FontWeight="Bold" FontSize="12"
                                    Padding="14,5" BorderThickness="1" BorderBrush="#5D4324" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2" x:Name="ScrollGameChatLog" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                        <ItemsControl x:Name="ListGameChatLogs">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgCardSub}" CornerRadius="6" Padding="12,8" Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Timestamp}" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,12,0" VerticalAlignment="Top"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="20"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- ⌨️ 인게임 채팅 입력부 (Row 3 정상 배치) -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <TextBlock x:Name="TxtChatEmotePreview" Text="" HorizontalAlignment="Left" Foreground="#E5C07B" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtCharLimit" Text="0 / 50자" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtGameChatInput" Grid.Column="0" KeyDown="TxtGameChatInput_KeyDown" TextChanged="TxtGameChatInput_TextChanged"
                                     MaxLength="50"
                                     Background="{StaticResource BgCardSub}" Foreground="{StaticResource TextPrimary}" BorderThickness="0"
                                     Padding="14,10" FontSize="15">
                                <TextBox.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                            <Button x:Name="BtnSendGameChat" Grid.Column="1" Content="게임 전송 ↵" Click="BtnSendGameChat_Click"
                                    Background="{StaticResource AccentBlue}" Foreground="White" FontWeight="Bold" FontSize="14"
                                    Padding="18,10" BorderThickness="0" Margin="8,0,0,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderColor}" Cursor="SizeWE"/>

            <!-- 5-2. 우측: 🤖 AI 코파일럿 대화 (상시 고정 & 엔진 선택기) -->
            <Border Grid.Column="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="4,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- AI 헤더 -->
                        <RowDefinition Height="Auto"/> <!-- 상시 슬림 안내 배너 -->
                        <RowDefinition Height="*"/>    <!-- AI 피드 -->
                        <RowDefinition Height="Auto"/> <!-- 완성형 문장 가이드 쉘프 및 입력부 -->
                    </Grid.RowDefinitions>

                    <!-- AI 엔진 선택기 헤더 -->
                    <Border Grid.Row="0" Background="#141E2E" BorderBrush="#253555" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,0,6">
                        <Grid>
                            <TextBlock Text="🤖 AI 기능" Foreground="#58A6FF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="엔진: " Foreground="{StaticResource TextSecondary}" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"
                                           ToolTip="현재 응답 엔진입니다. 기본값은 AI를 사용하지 않으며, PC에 Ollama 또는 CLI 에이전트가 설치되어 있으면 드롭다운에서 선택할 수 있습니다."/>
                                <ComboBox x:Name="CmbAiEngine" Style="{StaticResource DarkComboBox}" SelectionChanged="CmbAiEngine_SelectionChanged" Width="220" Margin="0,0,4,0">
                                    <ComboBoxItem Content="기본값 : AI 사용하지 않음" IsSelected="True"/>
                                </ComboBox>
                                <Button x:Name="BtnReloadAiModels" Content="🔄" Click="BtnReloadAiModels_Click" ToolTip="설치된 AI 엔진 새로고침"
                                        Background="#222733" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="14"
                                        Padding="8,4" BorderThickness="1" BorderBrush="#2E3A52" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 상시 슬림 안내 배너 -->
                    <Border Grid.Row="1" x:Name="BannerEngineStatus" Background="#131A26" BorderBrush="#202D42" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,0,6">
                        <TextBlock x:Name="TxtBannerEngineStatus" Text="기본값 : AI 사용하지 않음 (로컬 AI 연동 시 자유 대화 가능)" Foreground="#79B8FF" FontSize="12" FontWeight="SemiBold" TextAlignment="Center"/>
                    </Border>

                    <!-- AI 대화 피드 -->
                    <ScrollViewer Grid.Row="2" x:Name="ScrollAiFeed" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6">
                        <ItemsControl x:Name="ListAiMessages">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="12,8" Margin="8,2,50,6" MaxWidth="560">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#171A21"/>
                                                <Setter Property="BorderBrush" Value="#293040"/>
                                                <Setter Property="BorderThickness" Value="2,0,0,0"/>
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter Property="Background" Value="#2B3654"/>
                                                        <Setter Property="BorderBrush" Value="#5865F2"/>
                                                        <Setter Property="BorderThickness" Value="0,0,0,0"/>
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter Property="Margin" Value="50,2,14,6"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Sender}" FontSize="13" FontWeight="Bold" Margin="0,0,0,3">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentCyan}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" FontSize="14" LineHeight="20"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- 완성형 문장 가이드 쉘프 -->
                            <RowDefinition Height="Auto"/> <!-- 입력부 -->
                        </Grid.RowDefinitions>

                        <!-- 🎯 기본 모드 4대 핵심 실용 액션 패널 -->
                        <Border Grid.Row="0" x:Name="GuideShelfGrid" Background="#151A24" BorderBrush="#253555" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6" Visibility="Visible">
                            <UniformGrid Columns="4">
                                <Button x:Name="BtnActionDailyMissions" Content="📋 일일 숙제 점검" Click="BtnActionDailyMissions_Click"
                                        Background="#212738" Foreground="#79B8FF" FontWeight="Bold" FontSize="12" Padding="6,6" Margin="0,0,4,0" BorderThickness="1" BorderBrush="#35466A" Cursor="Hand" ToolTip="미완료된 일일 퀘스트를 즉시 확인하고 미션 탭으로 이동합니다."/>
                                <Button x:Name="BtnActionDiet" Content="⚖️ 가방 다이어트" Click="BtnActionDiet_Click"
                                        Background="#2D2319" Foreground="#F5CBA7" FontWeight="Bold" FontSize="12" Padding="6,6" Margin="2,0,4,0" BorderThickness="1" BorderBrush="#5D4324" Cursor="Hand" ToolTip="소지품 탭으로 이동하여 최근 급증한 무거운 잡템을 즉시 정리합니다."/>
                                <Button x:Name="BtnActionCollectWorks" Content="📥 작업대 수거" Click="BtnActionCollectWorks_Click"
                                        Background="#1B2F23" Foreground="#7EE787" FontWeight="Bold" FontSize="12" Padding="6,6" Margin="2,0,4,0" BorderThickness="1" BorderBrush="#2EA043" Cursor="Hand" ToolTip="완료된 가공 시설 대기열 아이템을 즉시 수거합니다."/>
                                <Button x:Name="BtnActionStop" Content="🛑 긴급 행동 정지" Click="BtnActionStop_Click"
                                        Background="#381D1D" Foreground="#FFA198" FontWeight="Bold" FontSize="12" Padding="6,6" Margin="2,0,0,0" BorderThickness="1" BorderBrush="#A42727" Cursor="Hand" ToolTip="진행 중인 모든 채집 및 이동 동작을 즉시 중단합니다."/>
                            </UniformGrid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtAiInput" Grid.Column="0" KeyDown="TxtAiInput_KeyDown"
                                     Background="{StaticResource BgCardSub}" Foreground="{StaticResource TextPrimary}" BorderThickness="1" BorderBrush="{StaticResource BorderColor}"
                                     Padding="14,10" FontSize="15">
                                <TextBox.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                            <Button x:Name="BtnSendAi" Grid.Column="1" Content="AI 질문 ↵" Click="BtnSendAi_Click"
                                    Background="{StaticResource AccentBlue}" Foreground="White" FontWeight="Bold" FontSize="14"
                                    Padding="18,10" BorderThickness="0" Margin="8,0,0,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
