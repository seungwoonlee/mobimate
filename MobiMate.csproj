<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;web\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- 빌드/퍼블리시 시 메신저 전송용 MobiMate.zip 자동 생성 -->
  <Target Name="ZipAfterPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <Exec Command="powershell -NoProfile -Command &quot;if (Test-Path '$(PublishDir)MobiMate.exe') { Compress-Archive -Path '$(PublishDir)MobiMate.exe' -DestinationPath '$(PublishDir)MobiMate.zip' -Force }&quot;" />
  </Target>

</Project>
