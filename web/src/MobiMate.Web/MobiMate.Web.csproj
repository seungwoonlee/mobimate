<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- 웹앱 로컬 서버. S3b에서 트레이(WinForms)·네트워크 프로필(COM)을 쓰므로 Windows 대상. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MobiMate.Web</RootNamespace>
    <AssemblyName>MobiMateWeb</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MobiMate.Core\MobiMate.Core.csproj" />
  </ItemGroup>

  <!-- 앱 셸을 출력 폴더에 복사한다 (S6에서 임베디드 리소스로 바꾼다) -->
  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MobiMate.Web.Tests" />
  </ItemGroup>

</Project>
