<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- 웹앱 로컬 서버. S3b에서 트레이(WinForms)·네트워크 프로필(COM)을 쓰므로 Windows 대상. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MobiMate.Web</RootNamespace>
    <AssemblyName>MobiMateWeb</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- 빌드 시각 기반 버전 <주>.<부>.MMdd.HHmm (NFR-16, WPF판 v1.2.0 방식). 첫 릴리스 전까지 0.9 -->
    <BuildStamp>$([System.DateTime]::Now.ToString("MMdd.HHmm"))</BuildStamp>
    <Version>0.9.$(BuildStamp)</Version>
    <InformationalVersion>0.9.$(BuildStamp)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- WinForms 전역 using은 ASP.NET Core 형식과 이름이 겹치므로 뺀다. 트레이 코드만 별칭으로 쓴다. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MobiMate.Core\MobiMate.Core.csproj" />
  </ItemGroup>

  <!-- 앱 셸을 출력 폴더에 복사한다 (S6에서 임베디드 리소스로 바꾼다) -->
  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MobiMate.Web.Tests" />
  </ItemGroup>

</Project>
