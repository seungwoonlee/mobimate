<Project Sdk="Microsoft.NET.Sdk">

  <!-- 웹앱 전용 로직. WPF판(master)과 코드를 공유하지 않는다(파일 복사로 출발, 이후 독립 발전). UI 의존 0. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MobiMate</RootNamespace>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- 배포(단일 exe)에 기호 파일을 남기지 않는다 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Homework\homework_catalog.json" LogicalName="MobiMate.Homework.homework_catalog.json" />
    <EmbeddedResource Include="Cutoff\cutoff_catalog.json" LogicalName="MobiMate.Cutoff.cutoff_catalog.json" />
    <EmbeddedResource Include="Life\work_categories.json" LogicalName="MobiMate.Life.work_categories.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MobiMate.Core.Tests" />
  </ItemGroup>

</Project>
