<Project Sdk="Microsoft.NET.Sdk">

  <!-- 게임 없이 테스트하기 위한 가짜 MabinogiMobile_CLI.exe. API_SPEC_SAMPLES.md 실측 응답을 재생한다. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MabinogiMobile_CLI</AssemblyName>
    <RootNamespace>MobiMate.FakeCli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Samples\*.json" LogicalName="Samples.%(Filename).json" />
  </ItemGroup>

</Project>
